# dependencies
node_modules/

# build outputs
dist/
.output/
.tanstack/
.turbo/
*.tsbuildinfo

# environment
.env
.env.*
!.env.example

# runtime data (uploads, local volumes)
data/

# local catalog seed/scrape data — never committed (redistribution, ADR-0001)
apps/catalog/seed/

# test
coverage/

# local compose overrides (host port clashes etc.)
docker-compose.local.yml

# browser HAR exports — capture full request bodies, so an export taken from a
# login or sign-up flow contains credentials in cleartext
*.har

# misc
.DS_Store
*.log
