# Trackt configuration
# All configuration is done via environment variables, validated at startup.
# In development every variable has a sensible default — you can run with no .env at all.
# In production (NODE_ENV=production) the variables marked [required] must be set.

NODE_ENV=development

# ── Server ────────────────────────────────────────────────────────────────────
# Port the API listens on (the web dev server runs on 3000 and proxies /api here)
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Public URL of the instance (used for auth callbacks, absolute links)
APP_URL=http://localhost:3000

# ── Database & cache ─────────────────────────────────────────────────────────
# [required in production]
DATABASE_URL=postgres://trackt:trackt@localhost:5432/trackt
REDIS_URL=redis://localhost:6379

# ── Auth ─────────────────────────────────────────────────────────────────────
# [required in production] Generate with: openssl rand -base64 32
AUTH_SECRET=

# ── Catalog (ADR-0001 / 0002 / 0004 / 0005) ──────────────────────────────────
# Base URL of the central slim catalog. Read live, never synced or mirrored:
# it backs federated search (ADR-0002), typed relations (ADR-0004) and the News
# section (ADR-0005). Development defaults to the local catalog service
# (apps/catalog, port 3002). Leaving it unset degrades each independently —
# local-only search results, genre-overlap relations, an empty news feed.
CATALOG_URL=

# How long each central read may take before it degrades. Defaults are tuned for
# an always-on catalog; raise them if yours scales to zero and you would rather
# wait out a cold start than lose the results.
# CATALOG_SEARCH_TIMEOUT_MS=1500
# CATALOG_RELATIONS_TIMEOUT_MS=1000
# CATALOG_NEWS_TIMEOUT_MS=2000

# Optional, reserved for future per-instance enrichment (descriptions/posters).
# Get a free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# Optional. Enables importing a user's anime/manga list from MyAnimeList
# (pnpm import:mal). Create an API client at https://myanimelist.net/apiconfig —
# the Client ID is enough for public lists, no user login or OAuth token needed.
MAL_CLIENT_ID=

# ── Account imports (optional) ───────────────────────────────────────────────
# Enables importing a user's movies and watched series (per season) from Trakt.
# Create an API app at https://trakt.tv/oauth/applications — the Client ID is
# enough for public profiles. AniList needs no credential at all.
TRAKT_CLIENT_ID=
#
# How the importers that scrape fetch pages: `http` (default), `browser`, or
# `fallback` (plain HTTP, escalating to a browser when Cloudflare challenges).
# Letterboxd is only offered in the app once this is browser or fallback.
# IMPORT_FETCH_MODE=fallback
#
# Attach to an already-running Chromium instead of launching one (optional).
# PLAYWRIGHT_WS_ENDPOINT=ws://127.0.0.1:9222
#
# Browser mode needs Playwright, which the image does not ship (300 MB of
# Chromium to read one public page): pnpm add -w playwright && pnpm exec
# playwright install chromium

# ── Feature flags (ADR-0011) ────────────────────────────────────────────────
# Emergency override, read at boot and on every evaluation: key=on|off|0-100.
# An unknown key is warned about and ignored, never fatal.
# FEATURE_FLAGS="lists.custom=off"
#
# Country targeting needs a source. Name the header YOUR reverse proxy sets
# (value ISO 3166-1 alpha-2); do not expose the API directly and trust one.
# FLAG_COUNTRY_HEADER=cf-ipcountry
# A single-region deployment can pin the country instead.
# FLAG_COUNTRY=FR

# ── Discord bot (optional) ───────────────────────────────────────────────────
# Create an application at https://discord.com/developers/applications. The bot
# only starts when DISCORD_BOT_TOKEN is set. Register its slash commands once
# with `pnpm --filter @trackt/discord register-commands`.
DISCORD_BOT_TOKEN=
DISCORD_APPLICATION_ID=
# DISCORD_GUILD_ID=

# ── Storage (covers for user-created entries) ────────────────────────────────
# Local directory by default; set the S3_* variables to use S3-compatible storage.
UPLOADS_DIR=./data/uploads
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Only used with the optional bundled MinIO (docker compose --profile minio).
# [required for that profile] MinIO refuses to start without a root password.
# MINIO_ROOT_USER=trackt
# MINIO_ROOT_PASSWORD=
