# Trackt configuration
# All configuration is done via environment variables, validated at startup.
# In development every variable has a sensible default — you can run with no .env at all.
# In production (NODE_ENV=production) the variables marked [required] must be set.

NODE_ENV=development

# ── Server ────────────────────────────────────────────────────────────────────
# Port the API listens on (the web dev server runs on 3000 and proxies /api here)
PORT=3001
HOST=0.0.0.0
LOG_LEVEL=info

# Public URL of the instance (used for auth callbacks, absolute links)
APP_URL=http://localhost:3000

# ── Database & cache ─────────────────────────────────────────────────────────
# [required in production]
DATABASE_URL=postgres://trackt:trackt@localhost:5432/trackt
REDIS_URL=redis://localhost:6379

# ── Auth ─────────────────────────────────────────────────────────────────────
# [required in production] Generate with: openssl rand -base64 32
AUTH_SECRET=

# ── Catalog (ADR-0001 / 0002 / 0004 / 0005) ──────────────────────────────────
# Base URL of the central slim catalog. Read live, never synced or mirrored:
# it backs federated search (ADR-0002), typed relations (ADR-0004) and the News
# section (ADR-0005). Development defaults to the local catalog service
# (apps/catalog, port 3002). Leaving it unset degrades each independently —
# local-only search results, genre-overlap relations, an empty news feed.
CATALOG_URL=

# How long each central read may take before it degrades. Defaults are tuned for
# an always-on catalog; raise them if yours scales to zero and you would rather
# wait out a cold start than lose the results.
# CATALOG_SEARCH_TIMEOUT_MS=1500
# CATALOG_RELATIONS_TIMEOUT_MS=1000
# CATALOG_NEWS_TIMEOUT_MS=2000

# Optional, reserved for future per-instance enrichment (descriptions/posters).
# Get a free key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# ── Storage (covers for user-created entries) ────────────────────────────────
# Local directory by default; set the S3_* variables to use S3-compatible storage.
UPLOADS_DIR=./data/uploads
# S3_ENDPOINT=
# S3_REGION=
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# Only used with the optional bundled MinIO (docker compose --profile minio).
# [required for that profile] MinIO refuses to start without a root password.
# MINIO_ROOT_USER=trackt
# MINIO_ROOT_PASSWORD=
