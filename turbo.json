{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**", ".tanstack/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "DATABASE_URL",
        "REDIS_URL",
        "AUTH_SECRET",
        "CATALOG_URL",
        "CATALOG_SEARCH_TIMEOUT_MS",
        "CATALOG_RELATIONS_TIMEOUT_MS",
        "CATALOG_NEWS_TIMEOUT_MS",
        "APP_URL",
        "PORT",
        "LOG_LEVEL",
        "TMDB_API_KEY",
        "UPLOADS_DIR"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "env": ["CI_REQUIRE_DB", "TEST_DATABASE_URL", "TEST_DATABASE_URL_*"]
    }
  }
}
